  90          int main(void)
  91          {
  92   1              Timer0_Config();
  93   1              UART0_Config();
  94   1              printf("UART ready\r\n");
  95   1      
  96   1              while(1)
  97   1              {       
  98   2                      uint8_t print_uptime = 0;
  99   2                      uint32_t seconds = 0;
 100   2      
 101   2                      IRQ_ALL_DISABLE();
 102   2                      if(uptime_second_pending)
 103   2                      {
 104   3                              seconds = uptime_seconds;
 105   3                              uptime_second_pending = 0;
 106   3                              print_uptime = 1;
 107   3                      }
 108   2                      IRQ_ALL_ENABLE();
 109   2      
 110   2                      if(print_uptime)
 111   2                      {
 112   3                              printf("Uptime: %lu s\r\n", seconds);
 113   3                      }
 114   2              }               
 115   1      }
