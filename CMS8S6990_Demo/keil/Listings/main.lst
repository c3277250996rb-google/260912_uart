  70          static void Timer0_Config(void)
  71          {
  72   1              /* 24 MHz / 12 = 2 MHz; 2000 counts produce a 1 ms interrupt. */
  73   1              TMR_ConfigRunMode(TMR0, TMR_MODE_TIMING, TMR_TIM_16BIT);
  74   1              TMR_ConfigTimerClk(TMR0, TMR_CLK_DIV_12);
  75   1              TMR_ConfigTimerPeriod(TMR0, 0xF8, 0x30);
  76   1              TMR_ClearOverflowIntFlag(TMR0);
  77   1              TMR_EnableOverflowInt(TMR0);
  78   1              IRQ_SET_PRIORITY(IRQ_TMR0, IRQ_PRIORITY_LOW);
  79   1              TMR_Start(TMR0);
  80   1      }
