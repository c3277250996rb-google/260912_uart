  84           ** \return none
  85          ******************************************************************************/
  86          void Timer0_IRQHandler(void)  interrupt TMR0_VECTOR 
  87          {
  88   1              TMR0_SET_PERIOD(0xF8, 0x30);
  89   1              TF0 = 0;
  90   1      
  91   1              if(++timer0_ms >= 1000)
  92   1              {
  93   2                      timer0_ms = 0;
  94   2                      ++uptime_seconds;
  95   2                      uptime_second_pending = 1;
  96   2              }
  97   1      }
