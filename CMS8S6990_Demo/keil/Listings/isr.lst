 120          /******************************************************************************
 121           ** \brief       UART 0 interrupt service function
 122           **
 123           ** \param [in]  none   
 124           **
 125           ** \return none
 126          ******************************************************************************/
 127          void UART0_IRQHandler(void)  interrupt UART0_VECTOR 
 128          {
 129   1              if(UART_GetSendIntFlag(UART0))
 130   1              {
 131   2                      UART_ClearSendIntFlag(UART0);
 132   2              }
 133   1              if(UART_GetReceiveIntFlag(UART0))
 134   1              {
 135   2                      UART_SendBuff(UART0, UART_GetBuff(UART0));
 136   2                      UART_ClearReceiveIntFlag(UART0);
 137   2              }
 138   1      }
