   3          /*
   4           * Initialize UART0 as an 8-bit asynchronous port clocked by the dedicated
   5           * BRT baud rate timer:
   6           *   - Baud rate: MY_UART_BAUD_RATE, using the precomputed MY_UART_BRT_PERIOD
   7           *     unless USE_FORMULA is defined, in which case the driver derives it.
   8           *   - Pins: MY_UART_TX_PIN / MY_UART_RX_PIN muxed to TXD0 / RXD0.
   9           *   - Receive interrupt enabled; received bytes are echoed back by
  10           *     UART0_IRQHandler_Task().
  11           */
  12          void UART0_Config(void)
  13          {
  14   1              uint16_t BRTValue = 0;
  15   1      
  16   1              /* 8-bit asynchronous mode, baud rate generated by the BRT timer. */
  17   1              UART_ConfigRunMode(UART0, UART_MOD_ASY_8BIT, UART_BAUD_BRT);
  18   1              UART_EnableReceive(UART0);
  19   1      
  20   1              /* BRT clock = Fsys / 1, and enable the baud rate doubler (SMOD = 1). */
  21   1              UART_ConfigBRTClk(BRT_CLK_DIV_1);
  22   1              UART_EnableDoubleFrequency(UART0);
  23   1      
  24   1      #ifdef USE_FORMULA
                      /* Let the driver derive the reload value from Systemclock. */
                      BRTValue = UART_ConfigBaudRate(UART0, MY_UART_BAUD_RATE);
              #else
  28   1              /* Precomputed value for the 48 MHz / 9600 bps configuration. */
  29   1              BRTValue = MY_UART_BRT_PERIOD;
  30   1      #endif
  31   1      
  32   1              /* Load BRTH:BRTL and start the baud rate timer. */
  33   1              UART_ConfigBRTPeriod(BRTValue);
  34   1              UART_EnableBRT();
  35   1      
  36   1              /* Route the UART0 signals to the selected port pins. */
  37   1              GPIO_SET_MUX_MODE(MY_UART_TX_PIN, GPIO_MUX_TXD0);
  38   1              GPIO_SET_MUX_MODE(MY_UART_RX_PIN, GPIO_MUX_RXD0);
  39   1      
  40   1              /* Enable the UART interrupt at the lowest priority level. */
  41   1              UART_EnableInt(UART0);
  42   1              IRQ_SET_PRIORITY(IRQ_UART0, IRQ_PRIORITY_LOW);
  43   1              IRQ_ALL_ENABLE();
  44   1      }
