  46          /*
  47           * UART0 interrupt task. Must be called from the UART0 ISR (see isr.c).
  48           * Clears the transmit flag and echoes every received byte back to the host.
  49           */
  50          void UART0_IRQHandler_Task(void)
  51          {
  52   1              if(UART_GetSendIntFlag(UART0))
  53   1              {
